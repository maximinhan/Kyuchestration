#!/bin/sh
# 코어 이미지의 실행 파일(core-ui-split-design.md 6.16 의 3 단계 정정). 인자는 코어의 동사 그대로다(`serve --stdio`).
#
# 설치 스크립트는 이 파일을 ~/.local/bin/kyuchestration-core 로 링크한다. 링크를 풀어 이미지 자리를 찾는다 — 링크가 놓인 자리
# 기준으로는 런타임도 jar 도 없다. 이미지에 든 런타임으로 띄우므로 WSL 에 자바가 없어도 된다.
set -eu
launcher=$(readlink -f "$0")
image_root=$(dirname "$(dirname "$launcher")")
exec "$image_root/runtime/bin/java" -cp "$image_root/lib/*" com.kyuchestration.desktop.core.CoreMainKt "$@"
